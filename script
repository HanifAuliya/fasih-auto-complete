  function parseOption(text) {
    const m = String(text || "")
      .trim()
      .match(/^\[?(\d{3})\]?\s*(.*)$/);
    return m
      ? { code: m[1], name: m[2].trim() }
      : { code: "", name: String(text || "").trim() };
