  // Halaman CATATAN + nyalakan "Tampilkan Anomali Usaha dan Keluarga"
  async function openCatatan() {
    closeDialogs();
    await goSection("CATATAN", () => !!findAnomaliSwitch());
    const control = () => {
      const s = findAnomaliSwitch();
      return s && s.parentElement.querySelector('[id$="-control"]');
    };
    const isOn = () => {
      const s = findAnomaliSwitch();
      const c = control();
      return (
        !!s &&
        (s.checked ||
          s.getAttribute("aria-checked") === "true" ||
          (c && c.hasAttribute("data-checked")))
      );
    };
    // Beberapa cara klik; berhenti begitu toggle benar-benar menyala
    const attempts = [
      () => triggerClick(control() || findAnomaliSwitch()),
      () => findAnomaliSwitch().click(),
      () => {
        const s = findAnomaliSwitch();
        s.focus();
        s.dispatchEvent(
          new KeyboardEvent("keydown", {
            key: " ",
            code: "Space",
            keyCode: 32,
            bubbles: true,
          }),
        );
        s.dispatchEvent(
          new KeyboardEvent("keyup", {
            key: " ",
            code: "Space",
            keyCode: 32,
            bubbles: true,
          }),
        );
      },
    ];
    for (const attempt of attempts) {
      if (isOn()) break;
      attempt();
      await waitFor(isOn, 2500);
    }
    if (isOn()) await sleep(1500); // daftar anomali dimuat
    runLog(`CATATAN: toggle anomali ${isOn() ? "aktif" : "GAGAL diaktifkan"}`);
