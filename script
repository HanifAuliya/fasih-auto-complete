      bar.addEventListener("click", (e) => {
        const act = e.target.closest("[data-bar]")?.dataset.bar;
        if (act === "stop") stopRun();
        if (act === "send") setPhase("submit");
        if (act === "skip")
          finishDoc("filled", "MODE UJI: terisi, belum dikirim");
        if (act === "next") {
          const r = loadRun();
          r.phase = "find";
          r.phaseAt = Date.now();
          r.holdReason = "";
          if (r.limit && r.processed >= r.limit) r.running = false;
          saveRun(r);
          updateRunBar();
          goList(r);
