  async function openFilterPanel() {
    if (fieldButton("KECAMATAN")) return;
    const btn = filterButton();
    if (!btn) throw new Error("Tombol Filter tidak ditemukan di halaman");
    triggerClick(btn);
    if (!(await waitFor(() => fieldButton("KECAMATAN"), 6000)))
